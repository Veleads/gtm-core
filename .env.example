# Core development and the central workers. Copy to .env (never commit).
DATABASE_URL=postgres://gtm:gtm@localhost:5432/gtm

# hatchet-lite from docker-compose: create a token in the UI at http://localhost:8888
HATCHET_CLIENT_TOKEN=
HATCHET_CLIENT_TLS_STRATEGY=none
HATCHET_CLIENT_HOST_PORT=localhost:7077

# Provider keys live ONLY on the workers (never in client repos). One per vendor, matching kit/providers/<slug>.md.
PLUSVIBE_API_KEY=
SMARTLEAD_API_KEY=
