{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 2
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "approval": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "approved_by": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "approved_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "type": "string"
        },
        "content_hash": {
          "description": "Fingerprint of the approved content, written by `gtm approve`. Never edit by hand.",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{16}$"
        },
        "approved_via": {
          "description": "Pull request whose review is the approval (GitHub mode). Written by `gtm approve --pr`.",
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "status",
        "approved_by",
        "approved_at"
      ]
    },
    "core": {
      "description": "Profile every segment shares. Segments only add or replace what differs",
      "type": "object",
      "properties": {
        "firmographics": {
          "default": {},
          "type": "object",
          "properties": {
            "industries": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "employee_count": {
              "type": "object",
              "properties": {
                "min": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "max": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              }
            },
            "revenue_usd": {
              "type": "object",
              "properties": {
                "min": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "max": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              }
            },
            "hq_countries": {
              "description": "ISO 3166-1 alpha-2",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 2,
                "maxLength": 2
              }
            },
            "technologies_any": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "technologies_none": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "keywords_any": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "keywords_none": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "segments": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "firmographics": {
            "default": {},
            "type": "object",
            "properties": {
              "industries": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "employee_count": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "max": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                }
              },
              "revenue_usd": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "max": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                }
              },
              "hq_countries": {
                "description": "ISO 3166-1 alpha-2",
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 2
                }
              },
              "technologies_any": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "technologies_none": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "keywords_any": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "keywords_none": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "personas": {
            "description": "Restrict to these persona ids; default: all personas",
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          }
        },
        "required": [
          "id",
          "description"
        ]
      }
    },
    "personas": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "role": {
            "type": "string",
            "enum": [
              "decision_maker",
              "champion",
              "influencer",
              "user"
            ]
          },
          "titles_any": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "titles_none": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "seniorities": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "c_level",
                "vp",
                "head",
                "director",
                "manager",
                "senior",
                "entry"
              ]
            }
          },
          "departments": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "role",
          "titles_any"
        ]
      }
    },
    "exclusions": {
      "default": {
        "domains": [],
        "industries": [],
        "hq_countries": []
      },
      "type": "object",
      "properties": {
        "domains": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!-)[a-z0-9-]+(\\.[a-z0-9-]+)+$"
          }
        },
        "industries": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hq_countries": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          }
        }
      }
    }
  },
  "required": [
    "version",
    "project_id",
    "approval",
    "segments",
    "personas"
  ]
}
