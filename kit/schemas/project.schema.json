{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 2
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "onboarding",
        "active",
        "paused",
        "closed"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "owners": {
      "type": "object",
      "properties": {
        "gtm_engineer": {
          "type": "string",
          "minLength": 1
        },
        "sdrs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "approver": {
          "type": "string",
          "minLength": 1,
          "description": "Person who signs off ICP and copy for this project"
        }
      },
      "required": [
        "gtm_engineer",
        "sdrs",
        "approver"
      ]
    },
    "regions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      },
      "description": "Target regions, e.g. EU, UK, US"
    },
    "features": {
      "default": {},
      "description": "Opt-in core features, see FEATURES",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "boolean"
      }
    }
  },
  "required": [
    "version",
    "project_id",
    "name",
    "status",
    "started_at",
    "owners",
    "regions"
  ]
}
