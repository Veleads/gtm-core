# Copy to .env (never commit). Provider API keys do NOT belong here: they go to this project's worker
# (local stack: ~/.gtm/stacks/<project_id>.secrets.env). `npx gtm stack up` writes the connection
# settings to ~/.gtm/stacks/<project_id>.env; set HATCHET_CLIENT_TOKEN here only for a hosted stack.
GTM_USER=jdoe
HATCHET_CLIENT_TOKEN=
